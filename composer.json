{
  "name": "wodby/wodby-sdk-php",
  "description": "Wodby SDK for PHP",
  "homepage": "https://wodby.com",
  "keywords": [
    "wodby",
    "sdk",
    "api",
    "cloud",
    "php"
  ],
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.15.5 || ^8.2",
    "guzzlehttp/psr7": "^2.13.1 || ^3.1"
  },
  "autoload": {
    "psr-4": {
      "Wodby\\Api\\": "SwaggerClient-php/lib"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "require-dev": {
    "codeception/codeception": "^5.3.5",
    "codeception/module-asserts": "^3.3"
  },
  "scripts": {
    "test": "php tests/dependencies.php"
  }
}
