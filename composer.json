{
  "name": "wodby/wodby-sdk-php",
  "description": "PHP SDK for the Wodby 2.0 Public API",
  "homepage": "https://wodby.com",
  "keywords": [
    "wodby",
    "sdk",
    "api",
    "cloud",
    "php"
  ],
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Wodby\\Api\\": "SwaggerClient-php/lib"
    }
  },
  "config": {
    "sort-packages": true
  }
}
